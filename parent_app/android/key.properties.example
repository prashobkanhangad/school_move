# Copy to android/key.properties (this file is gitignored).
#
# Google Maps (Android)
# 1. Enable Maps SDK for Android
# 2. Restrict the key to Android apps:
#      Package: com.schoolmove.parent
#      SHA-1:   (debug and upload-keystore SHA-1 — see PLAY_STORE.md)
#
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Play Store upload signing (generated by scripts/create-play-keystores.sh)
storeFile=upload-keystore.jks
storePassword=replace_me
keyAlias=upload
keyPassword=replace_me
